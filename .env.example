# Local Neo4j Desktop connection for ExoTrace.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=exotrace
# Optional: leave unset to be prompted securely in the terminal.
# Never commit your real .env file or paste your password into chat.
# NEO4J_PASSWORD=replace-with-your-local-password
