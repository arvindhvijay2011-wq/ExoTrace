# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Local data snapshots are reproducible but may be large.
# Keep manifests and data documentation in version control.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
data/manifests/*.json
!data/manifests/.gitkeep

# Secrets and local configuration
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Local Streamlit investigation history
data/manifests/ui_runs/
